# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API Key for LLM and embeddings
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Honegumi RAG Assistant
AX_DOCS_VECTORSTORE_PATH=data/processed/ax_docs_vectorstore
RETRIEVAL_TOP_K=5

# Optional: OpenAI model to use (default: gpt-5)
# OPENAI_MODEL_NAME=gpt-5

# Optional: Path to FAISS vector store for Ax documentation retrieval
# Set this after building the vector store with scripts/build_vector_store.py
# AX_DOCS_VECTORSTORE_PATH=data/processed/ax_docs_vectorstore

# Optional: Number of documents to retrieve from vector store (default: 5)
# RETRIEVAL_TOP_K=5

# Optional: Output directory for generated code (default: ./honegumi_rag_output)
# OUTPUT_DIR=./honegumi_rag_output

# Optional: Kaggle credentials for auto-submitting to the Acceleration Consortium
# optimization competitions (see data/raw/kaggle_competitions.yaml and
# scripts/submit_to_kaggle.py). Get these from https://www.kaggle.com/settings.
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key
# Modern access tokens are read from KAGGLE_API_TOKEN. KAGGLE_API_KEY is also
# accepted and routed automatically (legacy 32-hex key -> KAGGLE_KEY, otherwise
# treated as an access token -> KAGGLE_API_TOKEN).
# KAGGLE_API_TOKEN=your-kaggle-access-token
# KAGGLE_API_KEY=your-kaggle-api-key
