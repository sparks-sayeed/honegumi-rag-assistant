# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for the Claude agents.
# Embeddings run locally, so this is the only credential the pipeline needs.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: LangSmith tracing (recommended for debugging)
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Honegumi RAG Assistant

# Path to the FAISS vector store, set after building it with:
#   python -m honegumi_rag_assistant.build_vector_store
AX_DOCS_VECTORSTORE_PATH=data/processed/ax_docs_vectorstore

# Number of chunks retrieved per query (default: 5)
RETRIEVAL_TOP_K=5

# Optional: Claude model for the Parameter Selector (default: claude-sonnet-5)
# ANTHROPIC_MODEL_NAME=claude-sonnet-5

# Optional: per-agent model overrides (all default to claude-sonnet-5)
# CODE_WRITER_MODEL=claude-sonnet-5
# RETRIEVAL_PLANNER_MODEL=claude-sonnet-5
# REVIEWER_MODEL=claude-sonnet-5

# Optional: reasoning effort for the Code Writer.
# One of low | medium | high | xhigh | max (default: high). Higher values reason
# more deeply before rewriting the skeleton, at higher token cost.
# CODE_WRITER_EFFORT=high

# Optional: output token ceilings. On the Anthropic API, max_tokens caps thinking
# *plus* visible output, so leave headroom above the generated script.
# CODE_WRITER_MAX_TOKENS=16000
# STRUCTURED_MAX_TOKENS=8192

# Optional: local embedding model. Must match the model the vector store was
# built with, or retrieval returns meaningless results.
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Optional: Output directory for generated code (default: ./honegumi_rag_output)
# OUTPUT_DIR=./honegumi_rag_output
